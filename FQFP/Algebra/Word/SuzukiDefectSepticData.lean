module

public import FQFP.Algebra.Word.SuzukiSepticData
public import FQFP.Algebra.Word.CentralBinaryTable

/-!
# Integer quotient data for the degree-six Suzuki half-defect

The coefficient table is evaluated with ordinary letters scaled by `1/840`.
The central letter is the Suzuki parameter. The cubic relation is
`1 - 12p + 48p² - 60p³ = 0`.

## Main definitions

* `defectSepticQuotient`: an integer quotient by the parameter's cubic relation.
-/

@[expose] public section

namespace FQFP.SuzukiSepticCertificate

/-- An integer coefficient table with a central scalar and two ordered letters. -/
abbrev ParamTable := CoeffWordTable.Table ℤ (Option (Fin 2))

/-- Encode a parameter power followed by one seven-letter associative word. -/
def parameterWord (q code : ℕ) : List (Option (Fin 2)) :=
  List.replicate q none ++ (binaryWord code).map some

