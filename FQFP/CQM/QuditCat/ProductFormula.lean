module

public import FQFP.CQM.QuditCat.UnitaryEvolution
public import FQFP.Analysis.Normed.Algebra.ProductFormula.ErrorBounds

/-!
# Product-formula simulation errors for density states and POVMs

The existing commutator-scaling theorem is instantiated in the C*-algebra of continuous
linear operators on a qudit's complex Hilbert space. Its original order, stage-count,
skew-adjointness and nonnegative-time hypotheses and constants are retained.
The resulting operator error controls both trace distance and measurement probabilities.
-/

@[expose] public section

open scoped BigOperators RealScalar
open NormedSpace TrotterError

namespace QuditCat

noncomputable section

variable {H : QuditCat} {Υ Γ : ℕ}

private lemma starModule_real {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℚ 𝔸]
    [NormedAlgebra ℂ 𝔸] [CompleteSpace 𝔸] [StarRing 𝔸] [StarModule ℂ 𝔸]
    (N : NormedAlgebra ℝ 𝔸) : letI := N.toNormedSpace; StarModule ℝ 𝔸 := by
  have hN : N = NormedAlgebra.restrictScalars ℝ ℂ 𝔸 := Subsingleton.elim _ _
  subst N
  infer_instance

private lemma operator_error_bound {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℚ 𝔸]
    [NormedAlgebra ℂ 𝔸] [CompleteSpace 𝔸] [StarRing 𝔸] [StarModule ℂ 𝔸]
    [CStarRing 𝔸] [Nontrivial 𝔸] (N : NormedAlgebra ℝ 𝔸) :
    letI := N.toNormedSpace
    ∀ (P : ProductFormulaData Υ Γ) (A : Fin Γ → 𝔸)
      (_hA : ∀ i, star (A i) = -(A i)) (p : ℕ),
      1 ≤ p → P.IsOrderOf p A → 0 < Υ → ∀ t : ℝ, 0 ≤ t →
      ‖P.eval A t - exp (t • ∑ i, A i)‖ ≤
        2 / ((p + 1 : ℕ) : ℝ) * (Υ : ℝ) ^ (p + 1) * αComm p A * t ^ (p + 1) := by
  have hN : N = normedAlgebraReal 𝔸 := Subsingleton.elim _ _
  subst N
  have := starModule_real (𝔸 := 𝔸) (normedAlgebraReal 𝔸)
  exact fun P A hA p hp horder hΥ t ht =>
    trotter_error_bound_comm_scaling_of_skewAdjoint P A hA p hp horder hΥ t ht

/-- The unitary generated by a finite family of skew-adjoint Hilbert operators. -/
def exactEvolution (A : Fin Γ → H.state →L[ℂ] H.state)
    (hA : ∀ i, star (A i) = -(A i)) (t : ℝ) : unitary (H.state →L[ℂ] H.state) :=
  letI : NormedAlgebra ℚ (H.state →L[ℂ] H.state) := .restrictScalars ℚ ℂ _
  ⟨exp (t • ∑ i, A i), exp_smul_mem_unitary_of_skewAdjoint (sum_skewAdjoint A hA) t⟩

/-- The unitary obtained by evaluating a product formula on skew-adjoint Hilbert operators. -/
def productFormulaEvolution (P : ProductFormulaData Υ Γ)
    (A : Fin Γ → H.state →L[ℂ] H.state) (hA : ∀ i, star (A i) = -(A i)) (t : ℝ) :
    unitary (H.state →L[ℂ] H.state) :=
  letI : NormedAlgebra ℚ (H.state →L[ℂ] H.state) := .restrictScalars ℚ ℂ _
  ⟨P.eval A t, P.eval_mem_unitary_of_skewAdjoint A hA t⟩

/-- The commutator-scaling product-formula bound, transferred to density-state trace distance. -/
theorem traceDistance_productFormula_le (P : ProductFormulaData Υ Γ)
    (A : Fin Γ → H.state →L[ℂ] H.state) (hA : ∀ i, star (A i) = -(A i))
    (p : ℕ) (hp : 1 ≤ p) (horder : P.IsOrderOf p A) (hΥ : 0 < Υ)
    (t : ℝ) (ht : 0 ≤ t) (ρ : Density H) :
    (ρ.evolve (productFormulaEvolution P A hA t)).traceDistance
        (ρ.evolve (exactEvolution A hA t)) ≤
      2 / ((p + 1 : ℕ) : ℝ) * (Υ : ℝ) ^ (p + 1) * αComm p A * t ^ (p + 1) := by
  let : NormedAlgebra ℚ (H.state →L[ℂ] H.state) := .restrictScalars ℚ ℂ _
  have : Nontrivial H.state := not_subsingleton_iff_nontrivial.mp fun h =>
    ρ.op_ne_zero (Subsingleton.elim _ _)
  apply ρ.traceDistance_evolve_le
  exact operator_error_bound (NormedAlgebra.restrictScalars ℝ ℂ _) P A hA p hp horder hΥ t ht

/-- The same commutator constant bounds every outcome of any finite POVM. -/
theorem abs_probability_productFormula_sub_le {ι : Type*} [Fintype ι]
    (M : POVM H ι) (P : ProductFormulaData Υ Γ)
    (A : Fin Γ → H.state →L[ℂ] H.state) (hA : ∀ i, star (A i) = -(A i))
    (p : ℕ) (hp : 1 ≤ p) (horder : P.IsOrderOf p A) (hΥ : 0 < Υ)
    (t : ℝ) (ht : 0 ≤ t) (ρ : Density H) (i : ι) :
    |M.probability (ρ.evolve (productFormulaEvolution P A hA t)) i -
        M.probability (ρ.evolve (exactEvolution A hA t)) i| ≤
      2 / ((p + 1 : ℕ) : ℝ) * (Υ : ℝ) ^ (p + 1) * αComm p A * t ^ (p + 1) :=
  (M.abs_probability_sub_le_traceDistance _ _ i).trans
    (traceDistance_productFormula_le P A hA p hp horder hΥ t ht ρ)

end

end QuditCat
